---
import { site, sections } from '../config/site';

// Derived from the name so the logo mark can never drift out of sync.
const initials = site.name
  .split(/\s+/)
  .map((word) => word[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<header
  class="sticky top-0 z-40 border-b border-line bg-surface/85 backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 lg:px-8">
    <a
      href="#top"
      class="flex items-center gap-2.5 text-sm font-semibold tracking-tight text-ink"
    >
      <span
        class="grid h-8 w-8 place-items-center rounded-md bg-navy-700 text-xs font-bold tracking-tight text-white"
        aria-hidden="true">{initials}</span
      >
      <span>{site.name}</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
      {
        sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="text-sm font-medium text-body transition-colors hover:text-navy-700"
          >
            {section.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="#contact"
        class="rounded-md bg-navy-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-navy-800"
      >
        Get in touch
      </a>

      <!-- Mobile menu: a native <details> disclosure, so navigation works with
           zero client-side JavaScript and stays keyboard accessible. -->
      <details class="relative md:hidden">
        <summary
          class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-md border border-line text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation menu"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 18 18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M2 4.5h14M2 9h14M2 13.5h14" />
          </svg>
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute right-0 mt-2 w-52 rounded-lg border border-line bg-surface p-2 shadow-lg"
        >
          {
            sections.map((section) => (
              <a
                href={`#${section.id}`}
                class="block rounded-md px-3 py-2 text-sm font-medium text-body hover:bg-surface-alt hover:text-navy-700"
              >
                {section.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

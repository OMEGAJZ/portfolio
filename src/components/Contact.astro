---
import { site } from '../config/site';

const subject = encodeURIComponent('Data project enquiry');
const mailto = `mailto:${site.email}?subject=${subject}`;
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="border-t border-line bg-navy-800"
>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-navy-200">
        Contact
      </p>
      <h2
        id="contact-heading"
        class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl"
      >
        Have a data project in mind? Let's talk.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-navy-100">
        Whether it is a platform migration, a pipeline that needs rebuilding or
        a reporting layer that is not delivering — send a short description of
        the situation and I will come back to you with an honest assessment.
      </p>
    </div>

    <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
      <a
        href={mailto}
        class="inline-flex items-center justify-center gap-2 rounded-md bg-white px-6 py-3 text-base font-semibold text-navy-800 transition-colors hover:bg-navy-50"
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2.5" y="4" width="15" height="12" rx="2" />
          <path d="m3 5.5 7 5 7-5" />
        </svg>
        {site.email}
      </a>

      {
        site.linkedin && (
          <a
            href={site.linkedin}
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex items-center justify-center gap-2 rounded-md border border-navy-500 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-navy-700"
          >
            Connect on LinkedIn
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        )
      }
    </div>
  </div>
</section>

---
import Section from './Section.astro';
import { services } from '../data/services';
---

<Section
  id="services"
  kicker="Services"
  title="How I can help"
  intro="Engagements usually start with one of these problems. In practice they overlap — a cloud migration is rarely just a migration."
  alt
>
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      services.map((service) => (
        <li class="flex flex-col rounded-xl border border-line bg-surface p-7">
          <h3 class="text-base font-semibold text-ink">{service.title}</h3>
          <p class="mt-3 text-sm font-medium italic text-navy-600">
            {service.problem}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-body">
            {service.description}
          </p>
        </li>
      ))
    }
  </ul>
</Section>

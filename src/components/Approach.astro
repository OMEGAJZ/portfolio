---
import Section from './Section.astro';
import { approach } from '../data/approach';
---

<Section
  id="approach"
  kicker="Approach"
  title="From business requirement to running platform"
  intro="Most data projects do not fail on the technology. They fail in the gap between what the business asked for and what got built. Working across both sides is the part of the job I take most seriously."
>
  <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
    {
      approach.map((step, index) => (
        <li class="flex flex-col rounded-xl border border-line bg-surface-alt p-6">
          <span
            class="text-sm font-bold tabular-nums text-navy-500"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-3 text-base font-semibold text-ink">{step.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-body">
            {step.description}
          </p>
        </li>
      ))
    }
  </ol>
</Section>

---
interface Props {
  id: string;
  kicker: string;
  title: string;
  intro?: string;
  /** Tinted background, used to alternate between sections. */
  alt?: boolean;
  class?: string;
}

const { id, kicker, title, intro, alt = false, class: className = '' } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class={`border-t border-line ${alt ? 'bg-surface-alt' : 'bg-surface'} ${className}`}
>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
        {kicker}
      </p>
      <h2
        id={`${id}-heading`}
        class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl"
      >
        {title}
      </h2>
      {intro && <p class="mt-5 text-lg leading-relaxed text-body">{intro}</p>}
    </div>

    <div class="mt-12 sm:mt-14">
      <slot />
    </div>
  </div>
</section>
